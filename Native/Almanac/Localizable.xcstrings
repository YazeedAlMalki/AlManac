    "Saved to import history. Whether each test name matched the catalog is worked out next time Almanac opens.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُفظ في سجل الاستيراد. يُحدَّد ما إذا طابق كل اسم فحص الفهرسَ في المرة القادمة التي يُفتح فيها Almanac."
          }
        }
      }
    },
    "Saves the database and every laboratory document into one file on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ قاعدة البيانات وكل مستندات المختبر في ملف واحد على هذا الجهاز."
          }
        }
      }
    },
    "Saving retains the previous revision and records who changed it and when.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحفظ يُبقي المراجعة السابقة ويسجّل من غيّرها ومتى."
          }
        }
      }
    },
    "Scaled from a %lld mL serving to the amount logged. Typical values, not measured.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محسوبة من حصة %lld مل إلى الكمية المسجّلة. قيم نموذجية، غير مقيسة."
          }
        }
      }
    },
    "Scaled from a %lld mL serving to the amount logged. Your own figures.": {
      "localizations": {
        "ar": {
