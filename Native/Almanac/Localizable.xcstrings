          "stringUnit": {
            "state": "translated",
            "value": "أضفها بعدها"
          }
        }
      }
    },
    "Add at least one exercise before starting this day.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف تمرينًا واحدًا على الأقل قبل بدء هذا اليوم."
