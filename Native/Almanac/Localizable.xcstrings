    "Sleep, heart rate, steps and body composition sync from Apple Health.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُزامَن بيانات النوم ونبض القلب والخطوات وتكوين الجسم من تطبيق الصحة."
          }
        }
      }
    },
    "System": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النظام"
          }
        }
      }
    },
    "The digestion display is separate. Its daily fill rule remains undefined, so no completion state is inferred.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض الهضم منفصل. لم تُحدَّد بعدُ قاعدة امتلائه اليومية، لذا لا يُستنتَج أي اكتمال."
          }
        }
      }
    },
    "Track left/right arms and thighs": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبّع الذراعين والفخذين يمينًا ويسارًا"
          }
        }
      }
    },
