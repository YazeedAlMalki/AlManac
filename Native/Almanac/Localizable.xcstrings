    "Rows sharing a source_report_id form one report. Values, units, ranges and flags are stored verbatim; blank dates stay unknown; non-numeric values stay text; unranked re-imports are held for review.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصفوف التي تتشارك source_report_id تشكّل تقريرًا واحدًا. تُحفَظ القيم والوحدات والنطاقات والعلامات حرفيًا؛ وتبقى التواريخ الفارغة غير معروفة؛ وتبقى القيم غير الرقمية نصًّا؛ وتُعلَّق إعادات الاستيراد غير المرتّبة للمراجعة."
          }
        }
      }
    },
