      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل التذكيرات"
          }
        }
      }
    },
    "Almanac follows the language chosen for it in iOS Settings. Changing it restarts the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع Almanac اللغة المختارة له في إعدادات iOS. يُعاد تشغيل التطبيق عند تغييرها."
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المظهر"
          }
        }
      }
    },
    "Applies to new entries. Existing left/right measurements are kept while their treatment is awaiting a decision.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطبَّق على الإدخالات الجديدة. تُحفَظ قياسات اليمين واليسار الحالية إلى أن يُتَّخذ قرار بشأن معالجتها."
          }
        }
      }
    },
    "Attributions": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حقوق المصادر"
          }
        }
      }
    },
