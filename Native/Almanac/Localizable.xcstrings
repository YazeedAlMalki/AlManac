          "stringUnit": {
            "state": "translated",
            "value": "إضافة"
          }
        }
      }
    },
    "Add %@'s exercises after the %lld already logged today?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تضيف تمارين %@ بعد التمارين المسجّلة اليوم وعددها %lld؟"
          }
        }
      }
    },
    "Add a Diet Profile to set nutrition targets": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف ملفًا غذائيًا لتحديد أهداف التغذية"
          }
        }
      }
    },
    "Add a tag or a note before saving.": {
      "localizations": {
