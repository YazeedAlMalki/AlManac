  "strings": {
    "+250 ml": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "+250 مل"
          }
        }
      }
    },
    "Adds one large glass (250 ml) to today's water total.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
